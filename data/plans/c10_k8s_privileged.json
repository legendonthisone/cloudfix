{
  "format_version": "1.2",
  "terraform_version": "1.9.5",
  "resource_changes": [
    {
      "address": "kubernetes_deployment.log_shipper",
      "mode": "managed",
      "type": "kubernetes_deployment",
      "name": "log_shipper",
      "provider_name": "registry.terraform.io/hashicorp/kubernetes",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "metadata": [
            {
              "name": "log-shipper",
              "namespace": "production",
              "labels": {
                "app": "log-shipper",
                "environment": "production"
              }
            }
          ],
          "spec": [
            {
              "replicas": "3",
              "template": [
                {
                  "spec": [
                    {
                      "host_network": true,
                      "host_pid": true,
                      "container": [
                        {
                          "name": "shipper",
                          "image": "ghcr.io/example/log-shipper:1.4.2",
                          "security_context": [
                            {
                              "privileged": true,
                              "allow_privilege_escalation": true,
                              "run_as_user": 0
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
